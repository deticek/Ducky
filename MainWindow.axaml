
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="ducky.MainWindow"
        Title="Ducky"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Padding="0"
        Margin="0"
        ExtendClientAreaToDecorationsHint="False">

    <Grid Margin="0" RowDefinitions="Auto,*">

        <!-- Navbar -->
        <Grid x:Name="Navbar"
              Grid.Row="0"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              Background="#202020">

            <TextBlock x:Name="NavbarTitleText"
                       Grid.Column="0"
                       Text="Ducky"
                       VerticalAlignment="Center"
                       Margin="12,8"
                       FontWeight="SemiBold" />

            
            <Border x:Name="FileMenuBorder"
                    Grid.Column="1"
                    Margin="4"
                    Height="34"
                    CornerRadius="6"
                    ClipToBounds="True"
                    VerticalAlignment="Center">
                <Menu Background="Transparent">
                    <MenuItem x:Name="FileMenuRoot"
                              Header="File"
                              Height="34"
                              Padding="12,6">
                        <MenuItem Header="Open folder..." Click="OpenFolder_Click"/>
                        <MenuItem Header="Export text..." Click="ExportText_Click"/>
                        <MenuItem Header="Find..." Click="Find_Click"/>
                        <Separator/>
                        <MenuItem Header="Open manager" Click="OpenManager_Click"/>
                        <MenuItem Header="Close split" Click="CloseSplit_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit Ducky" Click="Exit_Click"/>
                    </MenuItem>
                </Menu>
            </Border>

            <Button x:Name="ManagerButton"
                    Grid.Column="2"
                    Content="Manager"
                    VerticalAlignment="Center"
                    Margin="4"
                    Padding="12,6"
                    Height="34"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    BorderThickness="0"
                    CornerRadius="6"
                    Cursor="Hand"
                    Click="OpenManager_Click"/>

            <!-- Active workspace -->
            <Border x:Name="WorkspaceLabelBorder"
                    Grid.Column="3"
                    Background="#404040"
                    BorderBrush="#606060"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,5"
                    Margin="4">

                <TextBlock x:Name="ActiveWorkspaceLabel"
                           VerticalAlignment="Center" />
            </Border>


            <!-- Workspace information -->
            <Border x:Name="WorkspaceInfoBox"
                    Grid.Column="3"
                    IsVisible="False"
                    HorizontalAlignment="Left"
                    Background="#604A20"
                    BorderBrush="#A07830"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,5"
                    Margin="4">

                <TextBlock x:Name="WorkspaceInfoText"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Timer -->
            <Button x:Name="TimerButton"
                    Grid.Column="4"
                    IsVisible="True"
                    VerticalAlignment="Center"
                    Margin="4"
                    Padding="12,6"
                    Background="#404040"
                    Foreground="White"
                    BorderBrush="#606060"
                    BorderThickness="1"
                    CornerRadius="3"
                    Cursor="Hand">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="◷"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="TimerText"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Terminal content -->
        <Grid x:Name="WorkspaceHost" Grid.Row="1" />

    </Grid>
</Window>
