
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="ducky.MainWindow"
        Title="Ducky"
        Padding="0"
        Margin="0"
        ExtendClientAreaToDecorationsHint="False">

    <Grid Margin="0" RowDefinitions="Auto,*">

        <!-- Navbar -->
        <Grid x:Name="Navbar"
              Grid.Row="0"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              Background="#202020">

            <TextBlock Grid.Column="0"
                       Text="Ducky"
                       VerticalAlignment="Center"
                       Margin="12,8"
                       FontWeight="SemiBold" />

            
            <!-- Help button -->
            <Button x:Name="HelpButton"
                    Grid.Column="1"
                    Content="Help"
                    VerticalAlignment="Center"
                    Margin="4"
                    Padding="12,6"
                    Background="#F4D03F"
                    Foreground="#202020"
                    BorderThickness="0"
                    CornerRadius="3"
                    Cursor="Hand" />
            
            <!-- Manager button -->
            <Button x:Name="ManagerButton"
                    Grid.Column="2"
                    Content="Manager"
                    VerticalAlignment="Center"
                    Margin="4"
                    Padding="12,6"
                    Background="#F4D03F"
                    Foreground="#202020"
                    BorderThickness="0"
                    CornerRadius="3"
                    Cursor="Hand" />

            <!-- Active workspace -->
            <Border Grid.Column="3"
                    Background="#404040"
                    BorderBrush="#606060"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,5"
                    Margin="4">

                <TextBlock x:Name="ActiveWorkspaceLabel"
                           VerticalAlignment="Center" />
            </Border>


            <!-- Workspace information -->
            <Border x:Name="WorkspaceInfoBox"
                    Grid.Column="3"
                    IsVisible="False"
                    HorizontalAlignment="Left"
                    Background="#604A20"
                    BorderBrush="#A07830"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,5"
                    Margin="4">

                <TextBlock x:Name="WorkspaceInfoText"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Timer -->
            <Button x:Name="TimerButton"
                    Grid.Column="4"
                    IsVisible="True"
                    VerticalAlignment="Center"
                    Margin="4"
                    Padding="12,6"
                    Background="#404040"
                    Foreground="White"
                    BorderBrush="#606060"
                    BorderThickness="1"
                    CornerRadius="3"
                    Cursor="Hand">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="◷"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="TimerText"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Terminal content -->
        <Grid x:Name="WorkspaceHost" Grid.Row="1" />

    </Grid>
</Window>
