
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ducky.DashboardView">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="32,30,32,35"
                    Spacing="25">

            <!-- Welcome -->
            <StackPanel Spacing="8">

                <TextBlock Text="Welcome back!"
                           FontSize="29"
                           FontWeight="Bold"/>

                <TextBlock Text="Everything you need to manage Ducky in one place."
                           FontSize="13"
                           Foreground="#A6A7B0"/>

            </StackPanel>

            <!-- Statistics -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="15">

                <!-- Workspaces -->
                <Border Grid.Column="0"
                        Background="#2B2D37"
                        BorderBrush="#3B3D47"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="19">

                    <StackPanel Spacing="13">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="WORKSPACES"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#A6A7B0"/>

                            <TextBlock Grid.Column="1"
                                       Text="▤"
                                       FontSize="19"
                                       Foreground="#EBDAC3"/>
                        </Grid>

                        <TextBlock x:Name="WorkspaceCountText"
                                   Text="03"
                                   FontSize="31"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Available workspaces"
                                   FontSize="11"
                                   Foreground="#92949F"/>

                    </StackPanel>
                </Border>

                <!-- Custom commands -->
                <Border Grid.Column="1"
                        Background="#2B2D37"
                        BorderBrush="#3B3D47"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="19">

                    <StackPanel Spacing="13">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="CUSTOM COMMANDS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#A6A7B0"/>

                            <TextBlock Grid.Column="1"
                                       Text="⌘"
                                       FontSize="19"
                                       Foreground="#EBDAC3"/>
                        </Grid>

                        <TextBlock Text="05"
                                   FontSize="31"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Configured commands"
                                   FontSize="11"
                                   Foreground="#92949F"/>

                    </StackPanel>
                </Border>

                <!-- Theme -->
                <Border Grid.Column="2"
                        Background="#2B2D37"
                        BorderBrush="#3B3D47"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="19">

                    <StackPanel Spacing="13">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="ACTIVE THEME"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#A6A7B0"/>

                            <TextBlock Grid.Column="1"
                                       Text="◐"
                                       FontSize="19"
                                       Foreground="#EBDAC3"/>
                        </Grid>

                        <TextBlock Text="Default"
                                   FontSize="25"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Current appearance"
                                   FontSize="11"
                                   Foreground="#92949F"/>

                    </StackPanel>
                </Border>

            </Grid>

            <!-- Quick Actions -->
            <StackPanel Spacing="13">

                <TextBlock Text="Quick Actions"
                           FontSize="17"
                           FontWeight="SemiBold"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="13">

                    <Button Grid.Column="0"
                            Classes="secondary-button"
                            HorizontalContentAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10">

                            <TextBlock Text="+"
                                       FontSize="18"/>

                            <TextBlock Text="New Workspace"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Classes="secondary-button"
                            HorizontalContentAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10">

                            <TextBlock Text="+"
                                       FontSize="18"
                                       Foreground="#EBDAC3"/>

                            <TextBlock Text="Create Command"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                </Grid>
            </StackPanel>

            <!-- Bottom section -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="15">

                <!-- Logs -->
                <Border Grid.Column="0"
                        Background="#2B2D37"
                        BorderBrush="#3B3D47"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="20"
                        Height="220">

                    <Grid RowDefinitions="Auto,*,Auto"
                          RowSpacing="12">

                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto">

                            <StackPanel Spacing="4">

                                <TextBlock Text="Recent Logs"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Application log output"
                                           FontSize="11"
                                           Foreground="#92949F"/>

                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="secondary-button"
                                    Padding="10,7"
                                    Click="RefreshLogs_Click">

                                <TextBlock Text="↻ Refresh"
                                           FontSize="11"/>
                            </Button>

                        </Grid>

                        <Border Grid.Row="1"
                                Background="#202127"
                                CornerRadius="7"
                                Padding="10">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">

                                <TextBlock x:Name="LogsText"
                                           Text="Loading logs..."
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#C8C8C8"
                                           TextWrapping="NoWrap"/>

                            </ScrollViewer>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Text="%LOCALAPPDATA%\Ducky\log.txt"
                                   FontSize="9"
                                   Foreground="#777A86"/>

                    </Grid>
                </Border>

                <!-- Recent activity -->
                <Border Grid.Column="1"
                        Background="#2B2D37"
                        BorderBrush="#3B3D47"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="20">

                    <StackPanel Spacing="15">

                        <TextBlock Text="Ducky Updates"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Stay up to date with the latest features"
                                   FontSize="11"
                                   Foreground="#92949F"/>

                        <Border Background="#343640"
                                CornerRadius="8"
                                Padding="12">

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">

                                <TextBlock Text="●"
                                           Foreground="#73C991"
                                           FontSize="12"/>

                                <StackPanel Spacing="3">

                                    <TextBlock Text="Update status not checked"
                                               FontSize="11"/>

                                        <TextBlock Text="Open Updates in Ducky Manager to check GitHub Releases."
                                               FontSize="10"
                                               Foreground="#92949F"/>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Updates require a public GitHub repository with published releases."
                                   FontSize="10"
                                   Foreground="#777A86"/>

                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
