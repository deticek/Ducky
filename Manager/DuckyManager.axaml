
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ducky.DuckyManager"
        Title="Ducky Manager"
        Width="1100"
        Height="750"
        MinWidth="850"
        MinHeight="600"
        Background="#202127"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>

        <!-- General text -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#F1F0EC"/>
            <Setter Property="FontFamily" Value="Inter"/>
        </Style>

        <!-- Navigation buttons -->
        <Style Selector="Button.nav-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B5B5BC"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>

        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Background" Value="#363841"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.nav-active">
            <Setter Property="Background" Value="#45434A"/>
            <Setter Property="Foreground" Value="#EBDAC3"/>
        </Style>

        <!-- Action buttons -->
        <Style Selector="Button.action-button">
            <Setter Property="Background" Value="#EBDAC3"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>

        <Style Selector="Button.action-button:pointerover">
            <Setter Property="Background" Value="#D8C5AA"/>
        </Style>

        <Style Selector="Button.secondary-button">
            <Setter Property="Background" Value="#3B3D47"/>
            <Setter Property="Foreground" Value="#F1F0EC"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>

        <Style Selector="Button.secondary-button:pointerover">
            <Setter Property="Background" Value="#494B56"/>
        </Style>

    </Window.Styles>

    <Viewbox Stretch="Uniform"
         StretchDirection="Both">

    <Grid Width="1100"
          Height="750"
          ColumnDefinitions="230,*"
          x:Name="ManagerLayout">

        <!-- SIDEBAR -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Background="#252730"
                BorderBrush="#383A43"
                BorderThickness="0,0,1,0">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="22,24,15,30">

                    <Border x:Name="LogoBadge"
                            Width="36"
                            Height="36"
                            CornerRadius="9"
                            Background="#EBDAC3"
                            VerticalAlignment="Center">

                        <TextBlock Text="D"
                                   Foreground="#333333"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel x:Name="LogoTextPanel"
                                VerticalAlignment="Center"
                                Spacing="2">

                        <TextBlock Text="DUCKY"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   LetterSpacing="2"/>

                        <TextBlock Text="MANAGER"
                                   FontSize="9"
                                   Foreground="#92949F"
                                   LetterSpacing="2"/>
                    </StackPanel>

                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationPanel"
                                Margin="13,0"
                                Spacing="5">

                    <TextBlock x:Name="GeneralLabel"
                               Text="GENERAL"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#777A86"
                               Margin="12,0,0,9"/>

                    <!-- Overview -->
                    <Button x:Name="OverviewButton"
                            Classes="nav-button"
                            Click="Overview_Click">

                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="▦" FontSize="17"/>
                            <TextBlock Text="Overview"/>
                        </StackPanel>
                    </Button>

                    <!-- Workspaces -->
                    <Button Classes="nav-button"
                            Click="Workspaces_Click"
                            x:Name="WorkspacesButton">

                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="▤" FontSize="17"/>
                            <TextBlock Text="Workspaces"/>
                        </StackPanel>
                    </Button>

                    <!-- Custom Commands -->
                    <Button Classes="nav-button"
                            Click="Command_Click"
                            x:Name="CommandButton">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="⌘" FontSize="17"/>
                            <TextBlock Text="Custom Commands"/>
                        </StackPanel>
                    </Button>

                    <!-- Configuration -->
                    <Button Classes="nav-button"
                        Click="Configuration_Click"
                            x:Name="ConfigSettingsButton">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="⚙️" FontSize="17"/>
                            <TextBlock Text="Configuration"/>
                        </StackPanel>
                    </Button>

                    <!-- Discord integration -->
                    <Button Classes="nav-button"
                        Click="Discord_Click"
                            x:Name="DiscordButton">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="⚙" FontSize="17"/>
                            <TextBlock Text="Discord integration"/>
                        </StackPanel>
                    </Button>

                    <!-- Api integracija -->
                    <Button Classes="nav-button"
                        Click="Api_Click"
                            x:Name="ApiButton">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="🗝️" FontSize="17"/>
                            <TextBlock Text="API integration"/>
                        </StackPanel>
                    </Button>

                    <!-- Logs -->
                    <Button Classes="nav-button"
                        Click="Logs_Click"
                            x:Name="LogsButton">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="📋" FontSize="17"/>
                            <TextBlock Text="Logs"/>
                        </StackPanel>
                    </Button>

                    <!-- Updates -->
                    <Button Classes="nav-button"
                        Click="Configuration_Click"
                            x:Name="ConfigurationButton">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="🔄️" FontSize="17"/>
                            <TextBlock Text="Updates"/>
                        </StackPanel>
                    </Button>

                    <!-- Themes -->
                    <Button Classes="nav-button"
                        x:Name="ThemesButton"
                        Click="Themes_Click"    >
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="◐" FontSize="17"/>
                            <TextBlock Text="Themes"/>
                        </StackPanel>
                    </Button>

                    <!-- Shortcuts -->
                    <Button  x:Name="ShortcutsButton"
                        Click="Shortcuts_Click"     
                    Classes="nav-button">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock Text="⌨" FontSize="17"/>
                            <TextBlock Text="Shortcuts"/>
                        </StackPanel>
                    </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom sidebar -->
                <StackPanel Grid.Row="2"
                            Margin="22,15,15,20"
                            Spacing="5">

                    <Border Height="1"
                            Background="#3A3C45"
                            Margin="0,0,0,12"/>

                    <TextBlock Text="DUCKY TERMINAL"
                               FontSize="10"
                               Foreground="#92949F"/>

                    <TextBlock Text="Version 1.0.0"
                               FontSize="11"
                               Foreground="#696C77"/>

                </StackPanel>

            </Grid>
        </Border>


        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1"
              RowDefinitions="65,*">

            <!-- TOP BAR -->
            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Background="#252730"
                    BorderBrush="#383A43"
                    BorderThickness="0,0,0,1">

                <Grid ColumnDefinitions="*,Auto"
                      Margin="28,0">

                    <StackPanel VerticalAlignment="Center"
                                Spacing="3">

                        <TextBlock Text="Ducky Manager"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Manage your terminal environment"
                                   FontSize="10"
                                   Foreground="#92949F"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">

                        <Border Background="#303B35"
                                CornerRadius="35"
                                Padding="10">

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="#73C991"
                                         VerticalAlignment="Center"/>

                                <TextBlock Text="Terminal running"
                                           FontSize="10"
                                           Foreground="#9AD9AE"/>

                            </StackPanel>
                        </Border>

                        <Button 
                        x:Name="SettingsButton"
                        Click="Settings_Click"    
                        Classes="secondary-button"
                                Padding="10,7">

                            <TextBlock Text="⚙"
                                       FontSize="15"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAGE CONTENT: Dashboard, Workspaces, etc. -->
            <ContentControl x:Name="PageContent"
                            Grid.Row="1"/>

        </Grid>
    </Grid>
</Viewbox>
</Window>