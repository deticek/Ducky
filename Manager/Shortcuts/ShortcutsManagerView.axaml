<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ducky.ShortcutsManager">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30" Spacing="20">
                <StackPanel Spacing="5">
                    <TextBlock Text="Keyboard shortcuts"
                               FontSize="27"
                               FontWeight="Bold"/>
                    <TextBlock Text="Change, reset, or disable Ducky keyboard shortcuts."
                               Foreground="#92949F"/>
                </StackPanel>

                <StackPanel x:Name="ShortcutsPanel"
                            Spacing="8"/>

                <TextBlock x:Name="StatusText"
                           Foreground="#9AD9AE"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="CaptureOverlay"
              IsVisible="False"
              Background="#CC000000"
              ZIndex="100"
              Focusable="True"
              KeyDown="CaptureOverlay_KeyDown">
            <Border Width="420"
                    MaxWidth="900"
                    Padding="28"
                    CornerRadius="12"
                    Background="#292B35"
                    BorderBrush="#555866"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Change keyboard shortcut"
                               FontSize="19"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Press the key or key combination to assign."
                               Foreground="#A5A6B0"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CapturePreview"
                               Text="Waiting for input..."
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="Press Escape to cancel."
                               Foreground="#92949F"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#F1F0EC"/>
        </Style>
        <Style Selector="Border.shortcut-card">
            <Setter Property="Background" Value="#252730"/>
            <Setter Property="BorderBrush" Value="#383A43"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#3B3D47"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#EBDAC3"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#49353A"/>
            <Setter Property="Foreground" Value="#F1B7B7"/>
        </Style>
    </UserControl.Styles>
</UserControl>
