<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>

    <AssemblyName>Ducky</AssemblyName>
    <RootNamespace>Ducky</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetCord" Version="1.0.0-beta.28" />
    <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.28" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-beta.28" />
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\ducky.conf" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests\**\*.cs" />
    <AvaloniaResource Include="Assets\logo.ico" />
  </ItemGroup>
</Project>